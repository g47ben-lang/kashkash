<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ══ Hero header ══════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="28dp"
            android:paddingBottom="20dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎙 VOICE AI"
                android:textSize="30sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:textColor="@color/white"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="שינוי קול בינה מלאכותית • זמן אמת"
                android:textSize="12sp"
                android:letterSpacing="0.05"
                android:textColor="@color/text_secondary"
                android:paddingTop="4dp"/>

            <!-- Status pill -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏹ מוכן"
                android:textSize="12sp"
                android:textColor="@color/accent_glow"
                android:background="@drawable/badge_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginTop="10dp"/>

        </LinearLayout>

        <!-- ══ AI Voice Cards ════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <!-- BIBI CARD -->
            <LinearLayout
                android:id="@+id/cardBibi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:background="@drawable/card_bibi_glow"
                android:clickable="true"
                android:focusable="true">

                <!-- Avatar circle with ring -->
                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp">

                    <ImageView
                        android:id="@+id/imgBibi"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bibi"
                        android:scaleType="fitCenter"/>

                    <ImageView
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_gravity="center"
                        android:src="@drawable/avatar_ring"/>

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ביבי"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:paddingTop="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Benjamin Netanyahu"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:paddingBottom="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖 AI"
                    android:textSize="10sp"
                    android:textColor="@color/accent_glow"
                    android:background="@drawable/badge_bg"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_marginBottom="10dp"/>

                <Button
                    android:id="@+id/previewBibi"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:text="▶  שמע"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:background="@drawable/btn_preview"/>

            </LinearLayout>

            <!-- TRUMP CARD -->
            <LinearLayout
                android:id="@+id/cardTrump"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:background="@drawable/card_trump_glow"
                android:clickable="true"
                android:focusable="true">

                <!-- Avatar circle with ring -->
                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp">

                    <ImageView
                        android:id="@+id/imgTrump"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_trump"
                        android:scaleType="fitCenter"/>

                    <ImageView
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_gravity="center"
                        android:src="@drawable/avatar_ring_red"/>

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="טראמפ"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:paddingTop="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Donald Trump"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:paddingBottom="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖 AI"
                    android:textSize="10sp"
                    android:textColor="@color/trump_color"
                    android:background="@drawable/badge_bg_red"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_marginBottom="10dp"/>

                <Button
                    android:id="@+id/previewTrump"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:text="▶  שמע"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:background="@drawable/btn_preview"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Selected mode label -->
        <TextView
            android:id="@+id/tvSelectedEffect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="מצב: רגיל"
            android:textSize="12sp"
            android:textColor="@color/accent_glow"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="12dp"/>

        <!-- AI model loader (populated dynamically) -->
        <LinearLayout
            android:id="@+id/rvcModelContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:visibility="gone"/>

        <!-- ══ Start / Stop button ════════════════════════════════════════════ -->
        <Button
            android:id="@+id/btnStartStop"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="20dp"
            android:text="▶  התחל"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/btn_start"/>

        <!-- ══ Manual voice controls ══════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:marginStart="16dp"
            android:marginEnd="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="14dp"
            android:padding="18dp"
            android:background="@drawable/card_glass">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎛  כוונון קול ידני"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/accent_purple"
                android:paddingBottom="14dp"/>

            <!-- Pitch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="2dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="גובה קול"
                    android:textSize="13sp" android:textColor="@color/text_primary"/>
                <TextView android:id="@+id/tvPitchValue"
                    android:layout_width="44dp" android:layout_height="wrap_content"
                    android:text="0" android:textSize="13sp"
                    android:textColor="@color/accent_glow" android:gravity="end"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="עבה" android:textSize="10sp" android:textColor="@color/text_hint"/>
                <SeekBar android:id="@+id/seekbarPitch"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:max="24" android:progress="12"
                    android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
                    android:progressTint="@color/accent_purple"
                    android:thumbTint="@color/accent_glow"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="דק" android:textSize="10sp" android:textColor="@color/text_hint"/>
            </LinearLayout>

            <!-- Echo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="2dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="הד / Echo"
                    android:textSize="13sp" android:textColor="@color/text_primary"/>
                <TextView android:id="@+id/tvEchoValue"
                    android:layout_width="44dp" android:layout_height="wrap_content"
                    android:text="0%" android:textSize="13sp"
                    android:textColor="@color/accent_glow" android:gravity="end"/>
            </LinearLayout>

            <SeekBar android:id="@+id/seekbarEcho"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:max="100" android:progress="0"
                android:paddingBottom="14dp"
                android:progressTint="@color/accent_blue"
                android:thumbTint="@color/accent_glow"/>

            <!-- Robot -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="2dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="רובוט / Robot"
                    android:textSize="13sp" android:textColor="@color/text_primary"/>
                <TextView android:id="@+id/tvRobotValue"
                    android:layout_width="44dp" android:layout_height="wrap_content"
                    android:text="0%" android:textSize="13sp"
                    android:textColor="@color/accent_glow" android:gravity="end"/>
            </LinearLayout>

            <SeekBar android:id="@+id/seekbarRobot"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:max="100" android:progress="0"
                android:progressTint="@color/teal_200"
                android:thumbTint="@color/accent_glow"/>

        </LinearLayout>

        <!-- ══ Quick DSP presets ══════════════════════════════════════════════ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡  אפקטים מהירים"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:paddingStart="20dp"
            android:paddingBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardNormal"
                android:layout_width="0dp" android:layout_height="68dp"
                android:layout_weight="1" android:layout_marginEnd="5dp"
                app:cardBackgroundColor="@color/card_bg" app:cardCornerRadius="12dp" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🎤" android:textSize="20sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="רגיל" android:textSize="11sp" android:textColor="@color/white"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardChild"
                android:layout_width="0dp" android:layout_height="68dp"
                android:layout_weight="1" android:layout_marginStart="5dp" android:layout_marginEnd="5dp"
                app:cardBackgroundColor="@color/card_bg" app:cardCornerRadius="12dp" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="👦" android:textSize="20sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="ילד" android:textSize="11sp" android:textColor="@color/white"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardOldMan"
                android:layout_width="0dp" android:layout_height="68dp"
                android:layout_weight="1" android:layout_marginStart="5dp" android:layout_marginEnd="5dp"
                app:cardBackgroundColor="@color/card_bg" app:cardCornerRadius="12dp" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="👴" android:textSize="20sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="זקן" android:textSize="11sp" android:textColor="@color/white"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardTelephone"
                android:layout_width="0dp" android:layout_height="68dp"
                android:layout_weight="1" android:layout_marginStart="5dp"
                app:cardBackgroundColor="@color/card_bg" app:cardCornerRadius="12dp" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📞" android:textSize="20sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="טלפון" android:textSize="11sp" android:textColor="@color/white"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- ══ Device selection ═══════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="14dp"
            android:padding="16dp"
            android:background="@drawable/card_glass">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎧  התקנים"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/accent_blue"
                android:paddingBottom="12dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="מיקרופון" android:textSize="11sp"
                android:textColor="@color/text_hint" android:paddingBottom="6dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp">

                <Button android:id="@+id/btnMicMain"
                    android:layout_width="0dp" android:layout_height="38dp"
                    android:layout_weight="1" android:layout_marginEnd="5dp"
                    android:text="📱  טלפון" android:textSize="12sp"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/btn_device"/>

                <Button android:id="@+id/btnMicComm"
                    android:layout_width="0dp" android:layout_height="38dp"
                    android:layout_weight="1" android:layout_marginStart="5dp"
                    android:text="🎧  אוזניה" android:textSize="12sp"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/btn_device"/>

            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider" android:layout_marginBottom="12dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="יציאת שמע" android:textSize="11sp"
                android:textColor="@color/text_hint" android:paddingBottom="6dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button android:id="@+id/btnOutEarpiece"
                    android:layout_width="0dp" android:layout_height="38dp"
                    android:layout_weight="1" android:layout_marginEnd="5dp"
                    android:text="👂  אוזן" android:textSize="11sp"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/btn_device"/>

                <Button android:id="@+id/btnOutSpeaker"
                    android:layout_width="0dp" android:layout_height="38dp"
                    android:layout_weight="1" android:layout_marginStart="5dp" android:layout_marginEnd="5dp"
                    android:text="🔊  רמקול" android:textSize="11sp"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/btn_device"/>

                <Button android:id="@+id/btnOutBluetooth"
                    android:layout_width="0dp" android:layout_height="38dp"
                    android:layout_weight="1" android:layout_marginStart="5dp"
                    android:text="🔵  BT" android:textSize="11sp"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/btn_device"/>

            </LinearLayout>
        </LinearLayout>

        <!-- ══ About ══════════════════════════════════════════════════════════ -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
            android:layout_marginBottom="14dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingBottom="30dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="אודות" android:textSize="11sp"
                android:textColor="@color/text_hint" android:letterSpacing="0.1"/>

            <TextView
                android:id="@+id/tvDeveloper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text='פותח על-ידי  חו"ב'
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/accent_purple"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"/>

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✉  g47ben@gmail.com"
                android:textSize="13sp"
                android:textColor="@color/accent_blue"
                android:paddingBottom="2dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="לחץ לשליחת מייל"
                android:textSize="10sp" android:textColor="@color/text_hint"/>

        </LinearLayout>

        <!-- Hidden stubs for view binding compatibility -->
        <LinearLayout android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
            <androidx.cardview.widget.CardView android:id="@+id/cardChipmunk"
                android:layout_width="1dp" android:layout_height="1dp"/>
            <androidx.cardview.widget.CardView android:id="@+id/cardDeep"
                android:layout_width="1dp" android:layout_height="1dp"/>
            <androidx.cardview.widget.CardView android:id="@+id/cardRobot"
                android:layout_width="1dp" android:layout_height="1dp"/>
            <androidx.cardview.widget.CardView android:id="@+id/cardEcho"
                android:layout_width="1dp" android:layout_height="1dp"/>
            <Button android:id="@+id/previewNormal" android:layout_width="1dp" android:layout_height="1dp"/>
            <Button android:id="@+id/previewChipmunk" android:layout_width="1dp" android:layout_height="1dp"/>
            <Button android:id="@+id/previewDeep" android:layout_width="1dp" android:layout_height="1dp"/>
            <Button android:id="@+id/previewRobot" android:layout_width="1dp" android:layout_height="1dp"/>
            <Button android:id="@+id/previewEcho" android:layout_width="1dp" android:layout_height="1dp"/>
            <Button android:id="@+id/previewChild" android:layout_width="1dp" android:layout_height="1dp"/>
            <Button android:id="@+id/previewOldMan" android:layout_width="1dp" android:layout_height="1dp"/>
            <Button android:id="@+id/previewTelephone" android:layout_width="1dp" android:layout_height="1dp"/>
            <SeekBar android:id="@+id/seekbarIntensity" android:layout_width="1dp" android:layout_height="1dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
