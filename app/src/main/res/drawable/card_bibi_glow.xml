<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow halo -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#331A5CAA"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <!-- Card body -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FF0D1F3C"
                android:centerColor="#FF102A55"
                android:endColor="#FF1A3A6B"
                android:type="linear"/>
            <stroke android:width="1.5dp" android:color="#FF2A5A9B"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</layer-list>
