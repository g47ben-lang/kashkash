<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Strong glow -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#442A7ACC"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <!-- Card body selected -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FF1A3A6B"
                android:centerColor="#FF2050AA"
                android:endColor="#FF2A60CC"
                android:type="linear"/>
            <stroke android:width="2dp" android:color="#FF4A90E8"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</layer-list>
